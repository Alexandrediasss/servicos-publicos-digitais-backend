# Configuração da API do Guia do Cidadão Digital.
#
# No computador: copie este arquivo para ".env" (na mesma pasta) e ajuste os valores.
# No Render: coloque as variáveis no painel do serviço (Environment). O Render não lê o .env.
#
# O arquivo .env NUNCA vai para o Git: ele pode ter chaves secretas e o repositório pode ser público.
# Variável vazia = usa o valor padrão.

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
# Porta usada por "python -m app" no computador. O site em desenvolvimento procura a API na 3001.
# No Render não precisa: ele define a porta sozinho.
PORT=3001

# Endereço(s) do site que podem chamar a API, separados por vírgula, SEM "/" no final.
# No computador: http://localhost:5173  |  No Render: o endereço do site na Netlify.
CORS_ORIGIN=http://localhost:5173

# 1 = a API está atrás de um proxy (Render) e o IP real vem no cabeçalho X-Forwarded-For.
# Deixe 0 no computador.
TRUST_PROXY=0

# ---------------------------------------------------------------
# Modelo de IA (LLM)
# ---------------------------------------------------------------
# Opções:
#   mock   -> resposta de demonstração, sem IA (bom para testar o site sem nada instalado)
#   ollama -> Llama rodando com o Ollama (https://ollama.com). Padrão: llama3.1:8b no seu computador
#   custom -> qualquer outra API compatível com a OpenAI (preencha LLM_BASE_URL e LLM_MODEL)
# Sem nada aqui, a API usa "mock".
LLM_PROVIDER=ollama

# Opcional: troca o modelo ou o endereço padrão do provedor.
# Padrões do ollama: LLM_MODEL=llama3.1:8b e LLM_BASE_URL=http://localhost:11434/v1
# Computador mais fraco? Use LLM_MODEL=llama3.2:3b (rode antes: ollama pull llama3.2:3b).
LLM_MODEL=
LLM_BASE_URL=

# Chave da API do provedor. O Ollama no seu computador NÃO precisa de chave.
# Só preencha se usar um provedor que exige chave. Nunca coloque a chave no código, no frontend ou no Git.
LLM_API_KEY=

# Criatividade da IA (0 = mais previsível). Baixo é melhor para não inventar informação.
LLM_TEMPERATURE=0.2
# Tamanho máximo da resposta (em tokens, mais ou menos 3/4 de uma palavra cada).
LLM_MAX_TOKENS=700
# Tempo máximo para a IA responder, em milissegundos (120000 = 2 minutos).
LLM_TIMEOUT_MS=120000

# ---------------------------------------------------------------
# RAG (base de conhecimento)
# ---------------------------------------------------------------
# Quantos trechos da base vão junto com cada pergunta.
RAG_TOP_K=4

# ---------------------------------------------------------------
# Limites de uso
# ---------------------------------------------------------------
# Tamanho máximo de cada mensagem (o resto é cortado).
MAX_MESSAGE_CHARS=1000
# Quantas mensagens da conversa vão para a IA (as mais recentes).
MAX_HISTORY_MESSAGES=8
# Perguntas por minuto para cada pessoa (IP). 0 desliga o limite.
RATE_LIMIT_PER_MINUTE=20
